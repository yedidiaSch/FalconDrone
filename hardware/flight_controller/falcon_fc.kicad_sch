	(text "SAM-M8Q symbol/footprint: SAM-M10Q is pin- and\nfootprint-compatible (u-blox UBX-22004868).\nLayout: middle of a solid >= 40x40 mm GND pour\n(50x50 ideal), top side, nothing above it, away\nfrom the nRF24, MCU and motor wiring.\nC24+C25+C26 = 5.8 uF, under LP5907's 10 uF limit.\nNo capacitor on RESET_N. V_BCKP open = no hot start.\nUART default 9600 8N1 (UBX + NMEA)."
		(exclude_from_sim no)
		(at 314.96 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ffe26641-5611-5a25-9e5f-55490e35defc")
	)
