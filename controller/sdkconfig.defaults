# Applied when sdkconfig is first generated. Change settings here (or via
# menuconfig + copy back) — controller/sdkconfig itself is not tracked.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 1 ms tick so vTaskDelayUntil can hold the 50 Hz radio period exactly.
CONFIG_FREERTOS_HZ=1000

# Radio: ESP-NOW (Wi-Fi) by default; nRF24 is the alternative. Bluetooth is
# never used — keep it out of the build.
CONFIG_FALCON_RADIO_ESPNOW=y
CONFIG_BT_ENABLED=n

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
