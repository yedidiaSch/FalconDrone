# Applied when sdkconfig is first generated. Change settings here (or via
# menuconfig + copy back) — controller/sdkconfig itself is not tracked.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 1 ms tick so vTaskDelayUntil can hold the 50 Hz radio period exactly.
CONFIG_FREERTOS_HZ=1000

# Radio: nRF24 by default (rc_carrier board); ESP-NOW (Wi-Fi) is the
# alternative for the breadboard rig. Bluetooth is never used — keep it out
# of the build.
CONFIG_FALCON_RADIO_NRF24=y
CONFIG_FALCON_PWR_KEEP=y
CONFIG_BT_ENABLED=n

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
